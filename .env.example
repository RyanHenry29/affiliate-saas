# --- Core ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://app:changeme@localhost:5432/affiliate_saas
REDIS_URL=redis://:changeme@localhost:6379

# --- Auth (JWT para API interna) ---
JWT_SECRET=generate-a-strong-random-string-here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=generate-another-strong-random-string
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed (admin master) ---
ADMIN_MASTER_EMAIL=admin@seu-dominio.com
ADMIN_MASTER_PASSWORD=UseAStrongPasswordHere!

# --- Segurança ---
ENCRYPTION_KEY=generate-a-32-char-random-string

# --- Billing (escolher um) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=

# --- Marketplaces (integrações oficiais) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=
SHOPEE_MOCK_MINER=true
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

# --- Gateway de mensagens (módulo de alto risco — ver README) ---
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=

# --- CORS (origens do frontend, separados por vírgula) ---
CORS_ORIGIN=https://affiliate-saas.vercel.app

# --- Frontend (URL pública da API, usada pelo app web) ---
NEXT_PUBLIC_API_URL=https://affiliate-saas-api.vercel.app/api

# --- Supabase (Auth social + banco Postgres) ---
# Backend (NestJS) — verifica JWTs do Supabase:
SUPABASE_URL=https://sua-url.supabase.co
SUPABASE_JWT_SECRET=seu-jwt-secret-do-supabase
# Chave de serviço (server-side apenas, NUNCA exponha ao client):
# SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend (Next.js) — usada pelo @supabase/ssr no browser e no middleware:
NEXT_PUBLIC_SUPABASE_URL=https://sua-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# --- LLM fallback (opcional — configuração global) ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
