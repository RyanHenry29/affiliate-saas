datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlanTier {
  STARTER
  PRO
  AGENCY
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum OfferStatus {
  PENDING
  PUBLISHED
  IGNORED
  FAILED
}

model Tenant {
  id            String        @id @default(uuid())
  name          String
  isAdminMaster Boolean       @default(false)
  createdAt     DateTime      @default(now())
  subscription  Subscription?
  users         User[]
  groups        Group[]
  instances     MessagingInstance[]

  @@index([isAdminMaster])
}

model Subscription {
  id                 String             @id @default(uuid())
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId           String             @unique
  plan               PlanTier
  status             SubscriptionStatus
  externalCustomerId String // ID no gateway de pagamento (Stripe/Mercado Pago)
  externalSubId      String?
  currentPeriodEnd   DateTime
  updatedAt          DateTime           @updatedAt

  @@index([status, currentPeriodEnd])
}

model User {
  id           String   @id @default(uuid())
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId     String
  email        String   @unique
  passwordHash String
  role         String   @default("MEMBER") // MEMBER | OWNER | ADMIN_MASTER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  refreshTokens RefreshToken[]

  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model MessagingInstance {
  id         String   @id @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  provider   String   // "whatsapp" | "telegram"
  name       String
  externalId String?  // instance name na Evolution API / bot token hash
  instanceId String   @default("")
  status     String   @default("DISCONNECTED")
  createdAt  DateTime @default(now())

  @@index([tenantId, provider])
}

model Group {
  id         String   @id @default(uuid())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tenantId   String
  externalId String   // ID do grupo no provider
  name       String
  nicheTags  String[] // nichos que este grupo recebe ("DONA_DE_CASA", ...)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

model Offer {
  id                String   @id @default(uuid())
  marketplace       String   // "shopee" | "amazon" | "aliexpress" | "awin"
  externalSku       String
  title             String
  affiliateUrl      String
  imageUrl          String?
  priceCents        Int
  originalPriceCents Int     @default(0)
  discountPercent   Float    @default(0) // 0..100
  rating            Float    @default(0)
  nicheTag          String   @default("GERAL") // DONA_DE_CASA | AUTOMOTIVO | ...
  status            OfferStatus @default(PENDING)
  scrapedAt         DateTime @default(now())
  dispatched        Boolean  @default(false)
  dedupeHash        String   @unique // hash(marketplace + externalSku) — evita reprocessamento
  priceHistory      OfferPriceHistory[]

  @@index([marketplace, scrapedAt])
  @@index([nicheTag])
  @@index([status])
}

model OfferPriceHistory {
  id         String   @id @default(uuid())
  offer      Offer    @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId    String
  priceCents Int
  createdAt  DateTime @default(now())

  @@index([offerId, createdAt])
}

model DispatchJob {
  id           String   @id @default(uuid())
  tenantId     String
  offerId      String
  groupId      String
  status       String   @default("PENDING") // PENDING | SENT | FAILED | RATE_LIMITED
  attempts     Int      @default(0)
  scheduledFor DateTime
  createdAt    DateTime @default(now())
  sentAt       DateTime?

  @@index([tenantId, status, scheduledFor])
}

model FeatureFlag {
  id          String   @id @default(uuid())
  tenantId    String?
  key         String
  enabled     Boolean  @default(false)
  description String?
  createdAt   DateTime @default(now())

  @@unique([key, tenantId])
  @@index([tenantId])
}

model Payment {
  id          String   @id @default(uuid())
  tenantId    String
  amount      Int
  method      String
  status      String
  type        String
  description String?
  externalId  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([externalId])
}

model AiProvider {
  id              String   @id @default(uuid())
  tenantId        String
  provider        String
  model           String
  apiKeyEncrypted String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([tenantId])
}

model Connection {
  id                   String   @id @default(uuid())
  tenantId             String
  marketplace          String
  label                String
  credentialsEncrypted String
  isActive             Boolean  @default(true)
  lastSyncAt           DateTime?
  createdAt            DateTime @default(now())
  metadata             Json?

  @@index([tenantId])
}

model Invite {
  id          String    @id @default(uuid())
  tenantId    String
  email       String
  token       String    @unique
  status      String
  acceptedById String?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model ApiKey {
  id         String    @id @default(uuid())
  tenantId   String
  name       String
  keyHash    String    @unique
  prefix     String
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([tenantId])
}

model AuditLog {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model WebhookEndpoint {
  id        String    @id @default(uuid())
  tenantId  String
  url       String
  events    String[]
  secret    String?
  isActive  Boolean   @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model AutomationRule {
  id         String   @id @default(uuid())
  tenantId   String?
  name       String
  trigger    String
  condition  String
  action     String
  isActive   Boolean  @default(true)
  config     Json?
  createdAt  DateTime @default(now())

  @@index([tenantId])
}

// Configuração de planos/preços — editável pelo admin master (não hardcoded)
model PlanConfig {
  tier            PlanTier @id
  name            String
  priceCents      Int      @default(0)
  apiCallsLimit   Int      @default(0)
  dispatchesLimit Int      @default(0)
  features        Json
  active          Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

// Configuração de pagamento via PIX (QR copia-e-cola) — definida pelo admin master
model PaymentConfig {
  id              String    @id // "default"
  pixKey          String?
  pixMerchantName String?
  pixCity         String?
  pixCopiaECola   String?
  pixEnabled      Boolean   @default(false)
  pixInstructions String?
  updatedAt       DateTime  @updatedAt
}
